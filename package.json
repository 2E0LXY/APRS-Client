{
  "name": "aprsnet-desktop",
  "version": "1.3.6",
  "description": "Native APRSNET.UK desktop client for Windows and Debian",
  "main": "main.js",
  "author": "Daren Loxley 2E0LXY",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux deb --x64"
  },
  "build": {
    "appId": "uk.aprsnet.desktop",
    "productName": "APRSNET Desktop",
    "copyright": "Copyright 2026 Daren Loxley 2E0LXY",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "HamRadio",
      "synopsis": "Native APRSNET desktop client",
      "description": "Installable APRSNET desktop client with a local renderer, live WebSocket feed, REST API integration, map, station list, messaging, weather, analytics and transmit tools.",
      "maintainer": "Daren Loxley <2e0lxy@amateur.radio>",
      "desktop": {
        "Name": "APRSNET Desktop",
        "Comment": "Native APRSNET desktop client",
        "Categories": "HamRadio;Network;"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "APRSNET Desktop"
    }
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  }
}
